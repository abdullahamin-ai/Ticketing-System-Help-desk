# ---- App ----
APP_NAME=Help Desk API
APP_ENV=production
DEBUG=0
API_V1_PREFIX=/api/v1

# ---- Database ----
MYSQL_DATABASE=helpdesk
MYSQL_USER=helpdesk
MYSQL_PASSWORD=helpdesk
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PORT=3306
DATABASE_URL=mysql+aiomysql://helpdesk:helpdesk@db:3306/helpdesk
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---- Security ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Initial admin (only used on first boot) ----
INITIAL_ADMIN_EMAIL[email protected]
INITIAL_ADMIN_PASSWORD=ChangeMeStrong2024
INITIAL_ADMIN_FULL_NAME=System Administrator

# ---- CORS ----
CORS_ORIGINS=*

# ---- Uploads ----
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_BYTES=10485760

# ---- API ----
API_PORT=8000

# ---- Logging ----
LOG_LEVEL=INFO
